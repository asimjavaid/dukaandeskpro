# DukaanDesk — local-only (no cloud sync)
# Copy to .env for local overrides.

# Nest sidecar
API_PORT=3847
WEB_ORIGIN=http://localhost:5173

# SQLite SoR — absolute path, or relative to cwd.
# Electron sets this to userData/dukaandesk.sqlite by default.
# CLI / smoke default: apps/api/data/dukaandesk.sqlite
# SQLITE_PATH=

# Session signing (HMAC). Change for production installs.
# SESSION_SECRET=change-me
# SESSION_TTL_DAYS=7

# Tax — simulate / queue only in P1 (no live FBR; no invented accept codes)
TAX_MODE=simulate
# Local drain interval (ms). 0 = disable auto process-next (smoke uses explicit POST).
# TAX_PROCESS_INTERVAL_MS=5000
# Optional force for simulate adapter when body.outcome omitted: accepted | rejected
# TAX_SIMULATE_OUTCOME=accepted

# Payments — cash + udhaar only (D24). No JazzCash / EasyPaisa packages.
