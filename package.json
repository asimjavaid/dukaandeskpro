{
  "name": "dukaandeskpro",
  "private": true,
  "version": "0.0.1",
  "description": "DukaanDesk Pro — multi-till retail POS with online ordering support (Electron + Nest + React + PostgreSQL)",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev:api": "pnpm --filter @dukaandeskpro/api start:dev",
    "dev:web": "pnpm --filter @dukaandeskpro/web dev",
    "dev:desktop": "pnpm --filter @dukaandeskpro/desktop dev",
    "build": "pnpm build:web && pnpm build:api",
    "build:desktop": "pnpm build:web && pnpm build:api",
    "build:api": "pnpm --filter @dukaandeskpro/api build",
    "build:web": "pnpm --filter @dukaandeskpro/web build",
    "start:prod": "pnpm --filter @dukaandeskpro/desktop start:prod",
    "package:win": "node scripts/package-win.mjs",
    "db:migrate": "pnpm --filter @dukaandeskpro/db migrate",
    "smoke": "node scripts/smoke.mjs",
    "test:slice1": "node scripts/test-slice1-auth-catalog.mjs",
    "smoke:slice1": "node scripts/test-slice1-auth-catalog.mjs",
    "test:slice2": "node scripts/test-slice2-stock.mjs",
    "smoke:slice2": "node scripts/test-slice2-stock.mjs",
    "test:slice3": "node scripts/test-slice3-pos-cash.mjs",
    "smoke:slice3": "node scripts/test-slice3-pos-cash.mjs",
    "test:slice4": "node scripts/test-slice4-udhaar.mjs",
    "smoke:slice4": "node scripts/test-slice4-udhaar.mjs",
    "test:slice5": "node scripts/test-tax-simple.mjs",
    "smoke:slice5": "node scripts/test-tax-simple.mjs",
    "test:tax-simple": "node scripts/test-tax-simple.mjs",
    "smoke:tax-simple": "node scripts/test-tax-simple.mjs",
    "test:slice6": "node scripts/test-slice6-backup.mjs",
    "smoke:slice6": "node scripts/test-slice6-backup.mjs",
    "test:slice7": "node scripts/test-slice7-analytics.mjs",
    "smoke:slice7": "node scripts/test-slice7-analytics.mjs",
    "test:slice8": "node scripts/test-slice8-staff.mjs",
    "smoke:slice8": "node scripts/test-slice8-staff.mjs",
    "test:slice9": "node scripts/test-slice9-receipt.mjs",
    "smoke:slice9": "node scripts/test-slice9-receipt.mjs",
    "test:slice10": "node scripts/test-slice10-split.mjs",
    "smoke:slice10": "node scripts/test-slice10-split.mjs",
    "test:slice11": "node scripts/test-slice11-collections.mjs",
    "smoke:slice11": "node scripts/test-slice11-collections.mjs",
    "test:slice12": "node scripts/test-slice12-backup-restore.mjs",
    "smoke:slice12": "node scripts/test-slice12-backup-restore.mjs",
    "test:backup-v2": "node scripts/test-backup-v2.mjs",
    "smoke:backup-v2": "node scripts/test-backup-v2.mjs",
    "test:slice13": "node scripts/test-slice13-settings.mjs",
    "smoke:slice13": "node scripts/test-slice13-settings.mjs",
    "test:slice14": "node scripts/test-slice14-cashier-today.mjs",
    "smoke:slice14": "node scripts/test-slice14-cashier-today.mjs",
    "test:slice15": "node scripts/test-slice15-empty-firstrun.mjs",
    "smoke:slice15": "node scripts/test-slice15-empty-firstrun.mjs",
    "test:slice16": "node scripts/test-slice16-i18n.mjs",
    "smoke:slice16": "node scripts/test-slice16-i18n.mjs",
    "test:slice17": "node scripts/test-slice17-packaging.mjs",
    "smoke:slice17": "node scripts/test-slice17-packaging.mjs",
    "test:slice18": "node scripts/test-slice18-cost-expenses.mjs",
    "smoke:slice18": "node scripts/test-slice18-cost-expenses.mjs",
    "test:slice19": "node scripts/test-slice19-barcodes.mjs",
    "smoke:slice19": "node scripts/test-slice19-barcodes.mjs",
